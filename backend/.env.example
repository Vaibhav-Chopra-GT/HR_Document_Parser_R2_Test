# ===================
# AI Provider Config
# ===================
AI_PROVIDER=openai                    # "openai" or "claude"

# OpenAI (if AI_PROVIDER=openai)
OPENAI_API_KEY=sk-...

# Anthropic Claude (if AI_PROVIDER=claude)
ANTHROPIC_API_KEY=sk-ant-...

# ===================
# Email (Resend)
# ===================
RESEND_API_KEY=re_...
EMAIL_FROM=Talently <verify@yourdomain.com>

# ===================
# Security
# ===================
SECRET_KEY=your-flask-secret-key-change-this
JWT_SECRET_KEY=your-jwt-secret-key-change-this
ENCRYPTION_KEY=

# ===================
# Database
# ===================
# Local: sqlite:///talently.db
# Production (Railway provides this automatically): postgresql://...
DATABASE_URL=sqlite:///talently.db

# ===================
# Cloud Storage (Production)
# ===================
# Get from Cloudinary dashboard: https://cloudinary.com/console
# Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=

# ===================
# App Config
# ===================
FLASK_ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
